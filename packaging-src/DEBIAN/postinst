#!/bin/sh
# 安装后提示
cat <<'EOF'
╭─ Synapse 已安装 ─────────────────────────────╮
│                                              │
│  现在可以直接运行:  synapse status           │
│                                              │
│  数据目录: ~/.config/synapse/                 │
│    - STATIONS.md   ← 你的站点清单(url/key)   │
│    - config.json   (sync-stations 生成)      │
│    - reports/      (体检报告落盘)            │
│                                              │
│  从旧版(目录内)数据已自动迁移(原文件保留)。   │
│  环境变量 SYNAPSE_HOME 可覆盖数据目录。      │
│                                              │
╰──────────────────────────────────────────────╯
EOF

# 装了桌面入口就得刷新缓存, 否则 KRunner / GNOME 启动器要重登录才搜得到
# (用户刚装完就去启动器里搜名字, 搜不到就会认为"没装上")。
update-desktop-database -q /usr/share/applications 2>/dev/null || true
gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true
exit 0
