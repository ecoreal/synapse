# bash completion for synapse(通过 python argparse 生成)
_synapse_completions() {
    local cur prev sub subs opts
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    subs="check watch diagnose doctor uptime prune fix import-from-pi cron timer issue sync-stations status"
    if [[ $COMP_CWORD -eq 1 ]]; then
        mapfile -t COMPREPLY < <(compgen -W "$subs" -- "$cur")
        return
    fi
    case "${COMP_WORDS[1]}" in
        check|watch)
            opts="--target --model --timeout --jobs -v --verbose --json --tools --cache --vision --image-file"
            ;;
        diagnose)
            opts="--target --model --base-url --api-key --timeout --vision --cache --image-file"
            ;;
        fix)
            opts="--target --model --fix --apply"
            ;;
        issue)
            opts="add list note status rm --target --model --kind --symptom --cause --plan --status --note --id"
            ;;
        sync-stations)
            opts="--default --check --tools --cache --vision --image-file --timeout --jobs -v --verbose --log"
            ;;
        cron)
            opts="--schedule --install"
            ;;
        timer)
            opts="on off status log run --interval --now"
            ;;
        doctor)
            opts="--json --stale-hours"
            ;;
        uptime)
            opts="--days --target --model --json"
            ;;
        prune)
            opts="--keep --days --apply --json"
            ;;
        status)
            opts="--json --stale-hours"
            ;;
        *)
            opts="--help"
            ;;
    esac
    mapfile -t COMPREPLY < <(compgen -W "$opts" -- "$cur")
}
complete -F _synapse_completions synapse
