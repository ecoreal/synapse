# bash completion for synapse
# 注意: 这份文件由 TestDocsConsistency 与真实 argparse 双向比对 ——
# 新增子命令/参数忘了补这里, 测试会红。不要再手工"看着差不多"。
_synapse_completions() {
    local cur prev sub subs opts
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    subs="check watch diagnose doctor uptime timeline best explain report prune fix import-from-pi cron timer issue sync-stations disable enable status"
    if [[ $COMP_CWORD -eq 1 ]]; then
        mapfile -t COMPREPLY < <(compgen -W "$subs" -- "$cur")
        return
    fi
    case "${COMP_WORDS[1]}" in
        check)
            opts="--target --model --timeout --jobs -v --verbose --json --tools --cache --vision --image-file --auto-issue"
            ;;
        watch)
            opts="--interval --target --model --timeout --jobs --vision --tools --cache --image-file"
            ;;
        diagnose)
            opts="--target --model --api-key --base-url --timeout --vision --cache --image-file --json"
            ;;
        fix)
            opts="--target --model --fix --apply"
            ;;
        import-from-pi)
            opts="--default --edit-hint"
            ;;
        issue)
            opts="add list note status rm --target --model --kind --symptom --cause --plan --text --id --new-status --status --filter --json"
            ;;
        disable|enable)
            opts="--dry-run --json"
            ;;
        sync-stations)
            opts="--default --dry-run --check --tools --cache --vision --image-file --timeout --jobs -v --verbose --log"
            ;;
        cron)
            opts="--schedule --install"
            ;;
        timer)
            opts="on off status log run --interval --now"
            ;;
        doctor)
            opts="--json --stale-hours --fix --apply"
            ;;
        uptime)
            opts="--days --target --model --by-station --json"
            ;;
        explain)
            opts="--days --limit --json"
            ;;
        timeline)
            opts="--days --target --top --json"
            ;;
        best)
            opts="--days --need --top --json"
            ;;
        report)
            opts="--days -o --out --json"
            ;;
        prune)
            opts="--keep --days --apply --json"
            ;;
        status)
            opts="--json --stale-hours --days"
            ;;
        *)
            opts="--help"
            ;;
    esac
    mapfile -t COMPREPLY < <(compgen -W "$opts" -- "$cur")
}
complete -F _synapse_completions synapse
